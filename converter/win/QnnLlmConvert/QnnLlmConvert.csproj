<Project Sdk="Microsoft.NET.Sdk">

  <!-- qnn-llm-convert.exe для Windows 11 x64: один самодостаточный файл. Python-ядро (converter/qnnllm) и
       requirements.txt вшиты ресурсом и распаковываются в %LOCALAPPDATA%\qnn-llm-convert при первом запуске. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>qnn-llm-convert</AssemblyName>
    <RootNamespace>QnnLlmConvert</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\qnnllm\**\*.py" LogicalName="app/qnnllm/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\requirements.txt" LogicalName="app/requirements.txt" />
  </ItemGroup>

</Project>
